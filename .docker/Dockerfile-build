# Single binary, single entrypoint: docker-compose (docker-compose.yml, run
# from the repo root) runs every service from this one image with a
# different `argvio <command>` — see docs/running-locally.md.

FROM golang:1.27-trixie AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/argvio ./cmd/argvio

FROM gcr.io/distroless/static-debian13:nonroot
WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /out/argvio ./
# Runtime-read files: the allowlist schema (hot-reloadable, so it needs to
# be a real file on disk, not baked into the Go binary) and the OpenAPI
# spec (served by `argvio serve metrics` when dev_mode is enabled).
COPY --chown=nonroot:nonroot schema/ ./schema/
COPY --chown=nonroot:nonroot openapi/ ./openapi/

ENTRYPOINT ["/app/argvio"]
