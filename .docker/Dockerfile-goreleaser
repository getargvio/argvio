# Used by goreleaser only: copies the prebuilt binary (see .goreleaser.yaml)
# rather than building it. For local dev, use .docker/Dockerfile-build
# instead.

FROM gcr.io/distroless/static-debian13:nonroot
WORKDIR /app

ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT

COPY --chown=nonroot:nonroot ${TARGETOS}/${TARGETARCH}${TARGETVARIANT:+/$TARGETVARIANT}/argvio ./
COPY --chown=nonroot:nonroot schema/ ./schema/
COPY --chown=nonroot:nonroot openapi/ ./openapi/

ENTRYPOINT ["/app/argvio"]
